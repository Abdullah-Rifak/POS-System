# MongoDB Configuration
# For MongoDB 6.0+ running locally
# Default: mongodb://localhost:27017/pos-system-db
# For custom MongoDB URI (e.g., with authentication):
# MONGO_URI=mongodb://user:password@localhost:27017/pos-system-db?authSource=admin
MONGO_URI=mongodb://localhost:27017/pos-system-db

# Backend Server Port
PORT=5000

# These are auto-generated in config.json, but can be customized:
# JWT_SECRET and JWT_EXPIRE are created automatically during first run
