{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "POS System",
  "version": "0.1.0",
  "identifier": "com.pos-system.desktop",

  "build": {
    "beforeDevCommand": {
      "script": "npm run start",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/build"
  },

  "app": {
    "windows": [
      {
        "title": "POS System - Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../backend", "../node_runtime"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
